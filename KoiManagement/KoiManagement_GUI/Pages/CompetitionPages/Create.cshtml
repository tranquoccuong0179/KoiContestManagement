@page
@model KoiManagement_GUI.Pages.CompetitionPages.CreateModel

@{
    ViewData["Title"] = "Create";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container my-5">
    <h1 class="text-center mb-4">Create Competition</h1>

    <h4 class="text-center mb-4">Competition Details</h4>
    <hr />

    <div class="row justify-content-center">
        <div class="col-md-6">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <!-- Name -->
                <div class="form-group mb-3">
                    <label asp-for="Competition.Name" class="form-label"></label>
                    <input asp-for="Competition.Name" class="form-control" placeholder="Enter competition name" />
                    <span asp-validation-for="Competition.Name" class="text-danger"></span>
                </div>

                <!-- Location -->
                <div class="form-group mb-3">
                    <label asp-for="Competition.Location" class="form-label"></label>
                    <input asp-for="Competition.Location" class="form-control" placeholder="Enter location" />
                    <span asp-validation-for="Competition.Location" class="text-danger"></span>
                </div>

                <!-- Start Date -->
                <div class="form-group mb-3">
                    <label asp-for="Competition.StartDate" class="form-label"></label>
                    <input asp-for="Competition.StartDate" class="form-control" type="date" />
                    <span asp-validation-for="Competition.StartDate" class="text-danger"></span>
                </div>

                <!-- End Date -->
                <div class="form-group mb-3">
                    <label asp-for="Competition.EndDate" class="form-label"></label>
                    <input asp-for="Competition.EndDate" class="form-control" type="date" />
                    <span asp-validation-for="Competition.EndDate" class="text-danger"></span>
                </div>

                <!-- Max Applications -->
                <div class="form-group mb-3">
                    <label asp-for="Competition.MaxApplication" class="form-label"></label>
                    <input asp-for="Competition.MaxApplication" class="form-control" type="number" placeholder="Max number of applications" />
                    <span asp-validation-for="Competition.MaxApplication" class="text-danger"></span>
                </div>

                <!-- Submit Button -->
                <div class="form-group text-center">
                    <input type="submit" value="Create" class="btn btn-primary btn-lg" />
                </div>
            </form>
        </div>
    </div>

    <!-- Back Link -->
    <div class="mt-4 text-center">
        <a asp-page="IndexAdmin" class="btn btn-outline-secondary">Back to List</a>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

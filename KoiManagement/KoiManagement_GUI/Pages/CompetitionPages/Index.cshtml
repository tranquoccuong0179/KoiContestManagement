@page
@model KoiManagement_GUI.Pages.CompetitionPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Competition[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Competition[0].Location)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Competition[0].StartDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Competition[0].EndDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Competition[0].MaxApplication)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Competition[0].Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Competition[0].Active)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Competition[0].CreateAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Competition[0].UpdateAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Competition[0].DeleteAt)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Competition) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Location)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.StartDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EndDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MaxApplication)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Active)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreateAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UpdateAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DeleteAt)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

@page
@model KoiManagement_GUI.Pages.CompetitionPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Competition[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Competition[0].Location)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Competition[0].StartDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Competition[0].EndDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Competition[0].MaxApplication)
            </th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Competition) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Location)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.StartDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EndDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MaxApplication)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> 
@*                 <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
 *@                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a> 
                <a asp-page="../CompetitionCategoryPages/Index" asp-route-competitionId="@item.Id">Competition Categories</a>
                    <a asp-page="../RegistrationPages/Create" asp-route-competitionId="@item.Id">Register</a>
            </td>
        </tr>
}
    </tbody>
</table>

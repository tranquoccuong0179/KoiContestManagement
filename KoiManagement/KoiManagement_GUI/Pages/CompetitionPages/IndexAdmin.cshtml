@page
@model KoiManagement_GUI.Pages.CompetitionPages.IndexAdminModel

@{
    ViewData["Title"] = "IndexAdmin";
    string? role = HttpContext.Session.GetString("Role");
}

<p class="text-end">
    <a asp-page="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle-fill me-1"></i>Create New Competition
    </a>
</p>
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.Competition[0].Name)</th>
            <th>@Html.DisplayNameFor(model => model.Competition[0].Location)</th>
            <th>@Html.DisplayNameFor(model => model.Competition[0].StartDate)</th>
            <th>@Html.DisplayNameFor(model => model.Competition[0].EndDate)</th>
            <th>@Html.DisplayNameFor(model => model.Competition[0].MaxApplication)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Competition)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.Location)</td>
                <td>@Html.DisplayFor(modelItem => item.StartDate)</td>
                <td>@Html.DisplayFor(modelItem => item.EndDate)</td>
                <td>@Html.DisplayFor(modelItem => item.MaxApplication)</td>
                <td>
                    @if (role != null && (role.Equals("Manager") || role.Equals("Admin")))
                    {
                        <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm me-1">
                            <i class="bi bi-pencil-fill"></i> Edit
                        </a>
                        <a href="javascript:void(0);" onclick="confirmDelete('@item.Id')" class="btn btn-danger btn-sm">
                            <i class="bi bi-trash-fill"></i> Delete
                        </a>
                        <!-- Hidden form for each row -->
                        <form id="deleteForm_@item.Id" method="post" style="display:none;">
                            <input type="hidden" name="id" value="@item.Id" />
                            <input type="submit" value="Delete" class="btn btn-danger" />
                        </form>
                    }
                    <a asp-page="../CompetitionCategoryPages/Index" asp-route-competitionId="@item.Id" class="btn btn-info btn-sm">Categories</a>
                </td>
            </tr>
        }
    </tbody>
</table>
@section Scripts {
    <script type="text/javascript">
        function confirmDelete(id) {
            if (confirm("Are you sure you want to delete this item?")) {
                // Set the form action to submit the delete request for the specific item
                var form = document.getElementById('deleteForm_' + id); // Select the specific form
                form.action = '@Url.Page("./IndexAdmin")' + '?handler=Delete'; // Pass to the handler
                form.submit(); // Submit the form
            }
        }
    </script>
}
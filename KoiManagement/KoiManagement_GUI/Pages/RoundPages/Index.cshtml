@page
@model KoiManagement_GUI.Pages.RoundPages.IndexModel

@{
    ViewData["Title"] = "Rounds";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    /* Make the table smaller, about 2/3 the previous size */
    .table {
        width: 60%; /* Set the table width to 60% */
        table-layout: fixed; /* Fixed layout for uniform structure */
        height: 300px; /* Set a smaller fixed height */
        margin: 0 auto; /* Center the table horizontally */
    }

        /* Table cell styling */
        .table td, .table th {
            padding: 0.75rem; /* Reduced padding for cells */
            font-size: 1rem; /* Slightly smaller font size */
            vertical-align: middle; /* Vertically center text */
            text-align: center; /* Center-align text horizontally */
        }

            /* Set specific column widths */
            .table th:nth-child(1), .table td:nth-child(1) {
                width: 30%; /* First column width */
            }

            .table th:nth-child(2), .table td:nth-child(2) {
                width: 30%; /* Second column width */
            }

            .table th:nth-child(3), .table td:nth-child(3) {
                width: 20%; /* Third column width */
            }

            .table th:nth-child(4), .table td:nth-child(4) {
                width: 20%; /* Fourth column width */
            }

        /* Optional: Make the table headers larger but not too big */
        .table th {
            background-color: #343a40; /* Dark background for headers */
            color: #fff; /* White text for headers */
            font-size: 1.2rem; /* Larger font size for headers */
        }

        /* Make rows and columns more square-like but smaller */
        .table tbody tr {
            height: 50px; /* Reduced row height for a smaller, more compact appearance */
        }

    /* Button styling */
    .btn-sm {
        padding: 0.25rem 0.5rem; /* Smaller padding for buttons */
        font-size: 0.9rem; /* Smaller font size for buttons */
    }

    /* Form styling for compact layout */
    .form-inline {
        display: inline-block;
    }

    .form-group {
        margin-bottom: 0.75rem; /* Reduced form group spacing */
    }
</style>




<div class="container my-5">
    <h1 class="text-center mb-4">Round Management</h1>

    <p class="text-end">
        <a asp-page="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle-fill me-1"></i>Create New Round
        </a>
    </p>

    <table class="table table-striped table-hover table-sm">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.Round[0].Name)</th>
                <th>@Html.DisplayNameFor(model => model.Round[0].OrderNumber)</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Round)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Name)</td>
                    <td>@Html.DisplayFor(modelItem => item.OrderNumber)</td>
                    <td>
                        <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm me-1">
                            <i class="bi bi-pencil-fill"></i> Edit
                        </a>
                        <a href="javascript:void(0);" onclick="confirmDelete('@item.Id')" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash-fill"></i> Delete
                        </a>
                        <form id="deleteForm-@item.Id" method="post" style="display: none;">
                            <input type="hidden" name="id" asp-for="@item.Id" />
                            <input type="submit" value="Delete" class="btn btn-danger" />
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script type="text/javascript">
        function confirmDelete(id) {
            if (confirm("Are you sure you want to delete this round?")) {
                var form = document.getElementById('deleteForm-' + id);
                form.action = '@Url.Page("./Index")' + '?handler=Delete'; 
                form.submit(); // Submit the form
            }
        }
    </script>
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />

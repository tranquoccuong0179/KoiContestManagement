@page
@model KoiManagement_GUI.Pages.RoundPages.IndexModel

@{
    ViewData["Title"] = "Rounds";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container my-5">
    <h1 class="text-center mb-4">Round Management</h1>

    <p class="text-end">
        <a asp-page="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle-fill me-1"></i>Create New Round
        </a>
    </p>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.Round[0].Name)</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Round)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Name)</td>
                    <td>
                        <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm me-1">
                            <i class="bi bi-pencil-fill"></i> Edit
                        </a>
                        <a href="javascript:void(0);" onclick="confirmDelete('@item.Id')" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash-fill"></i> Delete
                        </a>
                        <form id="deleteForm-@item.Id" method="post" style="display: none;">
                            <input type="hidden" asp-for="@item.Id" />
                            <input type="submit" value="Delete" class="btn btn-danger" />
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script type="text/javascript">
        function confirmDelete(id) {
            if (confirm("Are you sure you want to delete this round?")) {
                var form = document.getElementById('deleteForm-' + id);
                form.action = '@Url.Page("./Delete")' + "?id=" + id;
                form.submit(); // Submit the form
            }
        }
    </script>
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />

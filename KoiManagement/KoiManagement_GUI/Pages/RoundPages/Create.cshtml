@page
@model KoiManagement_GUI.Pages.RoundPages.CreateModel

@{
    ViewData["Title"] = "Create";
    string? result = ViewData["Result"] as string;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container my-5">
    <h1 class="text-center mb-4">Create Round</h1>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <form method="post">
                @{
                    if (!string.IsNullOrEmpty(result))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @Html.Raw(result)
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                }
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group mb-3">
                    <label asp-for="Round.Name" class="form-label"></label>
                    <input asp-for="Round.Name" class="form-control" />
                    <span asp-validation-for="Round.Name" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Round.OrderNumber" class="form-label"></label>
                    <input asp-for="Round.OrderNumber" class="form-control" />
                    <span asp-validation-for="Round.OrderNumber" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <input type="submit" value="Create" class="btn btn-primary w-100" />
                </div>
            </form>
        </div>
    </div>

    <div class="text-center mt-3">
        <a asp-page="Index" class="btn btn-outline-secondary">
            Back to List
        </a>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

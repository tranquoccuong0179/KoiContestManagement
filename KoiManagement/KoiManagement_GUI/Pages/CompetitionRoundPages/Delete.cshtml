@page
@model KoiManagement_GUI.Pages.CompetitionRoundPages.DeleteModel

@{
    ViewData["Title"] = "Xóa vòng thi đấu";
}

<div class="container mt-4">
    <div class="card shadow border-0">
        <div class="card-header bg-danger text-white py-3">
            <h4 class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Xác nhận xóa vòng thi đấu</h4>
        </div>

        <div class="card-body p-4">
            <div class="alert alert-warning" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>
                <strong>Cảnh báo:</strong> Hành động này không thể hoàn tác. Tất cả dữ liệu liên quan đến vòng thi đấu
                này sẽ bị xóa vĩnh viễn.
            </div>

            <div class="mt-4">
                <h5 class="text-secondary mb-3">Thông tin chi tiết:</h5>
                <div class="bg-light p-3 rounded">
                    <dl class="row mb-0">
                        <dt class="col-sm-3 text-muted">Cuộc thi:</dt>
                        <dd class="col-sm-9 fw-bold">@Model.CompetitionName</dd>

                        <dt class="col-sm-3 text-muted">Vòng thi đấu:</dt>
                        <dd class="col-sm-9 fw-bold">@Model.RoundName</dd>
                    </dl>
                </div>
            </div>

            <form method="post" class="mt-4">
                <input type="hidden" asp-for="CompetitionId" />
                <input type="hidden" asp-for="RoundId" />

                @if (!ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        <div asp-validation-summary="All" class="text-danger"></div>
                    </div>
                }

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-page="./Index" class="btn btn-light px-4">
                        <i class="fas fa-arrow-left me-2"></i>Quay lại
                    </a>
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="fas fa-trash-alt me-2"></i>Xác nhận xóa
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            border-radius: 10px;
        }

        .card-header {
            border-radius: 10px 10px 0 0 !important;
        }

        .btn {
            border-radius: 5px;
            font-weight: 500;
        }

        .alert {
            border-left: 4px solid;
        }

        .alert-warning {
            border-left-color: #ffc107;
        }

        .alert-danger {
            border-left-color: #dc3545;
        }
    </style>
}

@section Scripts {
    <script>
        // Hiệu ứng fade out cho alert messages
        setTimeout(function () {
            $('.alert:not(.alert-warning)').fadeOut('slow');
        }, 3000);
    </script>
}

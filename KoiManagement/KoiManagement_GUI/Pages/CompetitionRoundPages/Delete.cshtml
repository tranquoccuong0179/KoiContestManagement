@page
@model KoiManagement_GUI.Pages.CompetitionRoundPages.DeleteModel

@{
    ViewData["Title"] = "Xóa vòng thi đấu";
}

<div class="container mt-4">
    <div class="card rounded-3 shadow border-0">
        <div class="card-header bg-danger text-white py-3 rounded-top">
            <h4 class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Xác nhận xóa vòng thi đấu</h4>
        </div>

        <div class="card-body p-4">
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show border-start border-4" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="alert alert-warning border-start border-4" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>
                <strong>Cảnh báo:</strong> Hành động này không thể hoàn tác. Tất cả dữ liệu liên quan đến vòng thi đấu
                này sẽ bị xóa vĩnh viễn.
            </div>

            <div class="mt-4">
                <h5 class="text-secondary mb-3">Thông tin chi tiết:</h5>
                <div class="bg-light p-3 rounded">
                    <dl class="row mb-0">
                        <dt class="col-sm-3 text-muted">Cuộc thi:</dt>
                        <dd class="col-sm-9 fw-bold">@Model.CompetitionName</dd>

                        <dt class="col-sm-3 text-muted">Hạng mục:</dt>
                        <dd class="col-sm-9 fw-bold">@Model.CategoryName</dd>

                        <dt class="col-sm-3 text-muted">Vòng thi đấu:</dt>
                        <dd class="col-sm-9 fw-bold">@Model.RoundName</dd>
                    </dl>
                </div>
            </div>

            <form method="post" class="mt-4">
                <input type="hidden" asp-for="CompetitionCategoryId" />
                <input type="hidden" asp-for="RoundId" />

                @if (!ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        <div asp-validation-summary="All" class="text-danger"></div>
                    </div>
                }

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-page="./Index" class="btn btn-light fw-medium rounded-2 px-4">
                        <i class="fas fa-arrow-left me-2"></i>Quay lại
                    </a>
                    <button type="submit" class="btn btn-danger fw-medium rounded-2 px-4">
                        <i class="fas fa-trash-alt me-2"></i>Xác nhận xóa
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        setTimeout(function () {
            $('.alert:not(.alert-warning)').fadeOut('slow');
        }, 3000);
    </script>
}

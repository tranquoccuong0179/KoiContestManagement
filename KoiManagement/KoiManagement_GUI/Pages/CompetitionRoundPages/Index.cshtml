@page
@model KoiManagement_GUI.Pages.CompetitionRoundPages.IndexModel

@{
    ViewData["Title"] = "Competition Round List";
}

<div class="container mt-4">
    <h1 class="text-center mb-4">Danh sách vòng thi đấu</h1>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Cuộc thi</th>
                        <th>Vòng</th>
                        <th>Danh sách Koi</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.CompetitionRoundWithKoi)
                    {
                        <tr>
                            <td class="align-middle">@item.Key.Competition.Name</td>
                            <td class="align-middle">@item.Key.Round.Name</td>
                            <td>
                                <ul class="list-unstyled mb-0">
                                    @foreach (var koi in item.Value)
                                    {
                                        <li class="mb-1">
                                            <a asp-page="./Details" asp-route-id="@koi.Id" class="text-decoration-none">
                                                <i class="bi bi-arrow-right-circle me-2"></i>@koi.Name
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </td>
                            <td class="align-middle">
                                <a asp-page="./Delete" asp-route-competitionId="@item.Key.Competition.Id"
                                    asp-route-roundId="@item.Key.Round.Id" class="btn btn-danger">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

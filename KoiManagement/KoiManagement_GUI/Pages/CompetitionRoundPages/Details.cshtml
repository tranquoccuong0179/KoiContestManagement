@page
@model KoiManagement_GUI.Pages.CompetitionRoundPages.DetailsModel

@{
    ViewData["Title"] = "Chi tiết Koi trong vòng thi đấu";
    if (HttpContext.Session.GetString("Id") is null)
    {
        Response.Redirect("/LoginPage");
    }
}

<head>
    <style>
        .item-background {
            background-color: #3b5d50;
            opacity: 0.85;
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border-radius: 20px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .item-info {
            left: 5%;
            padding: 1.5rem;
            width: 90%;
            padding-bottom: 80px;
        }

        .container {
            margin-top: 20px;
            margin-bottom: 20px;
        }

        .koi-thumbnail {
            max-height: 350px;
            object-fit: cover;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
            transition: transform 0.3s ease;
        }

        .koi-thumbnail:hover {
            transform: scale(1.02);
        }

        .action-buttons {
            margin-top: 20px;
            position: absolute;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            width: 90%;
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-top: 0;
        }

        .action-buttons .btn {
            padding: 8px 25px;
            border-radius: 10px;
            transition: all 0.3s ease;
        }

        .action-buttons .btn:hover {
            transform: translateY(-2px);
        }

        .text-white dt {
            font-weight: bold;
            font-size: 1rem;
            margin-bottom: 0.3rem;
            color: #e9ecef;
        }

        .text-white dd {
            font-size: 1rem;
            margin-bottom: 0.8rem;
        }

        .page-title {
            font-size: 2rem;
            margin-bottom: 1.5rem;
            color: #3b5d50;
            font-weight: 600;
        }

        .info-container {
            min-height: 400px;
            position: relative;
        }
    </style>
</head>

<div class="container">
    <div>
        <h2 class="animate__animated animate__slideInLeft text-center page-title">@Model.Koi.Name</h2>
        <div class="row g-4">
            <div class="col-md-5 animate__zoomInLeft animate__animated text-center">
                <img class="koi-thumbnail img-fluid" src="@Html.DisplayFor(model => model.Koi.Image)"
                    alt="@Html.DisplayFor(model => model.Koi.Id)" />
            </div>
            <div class="col-md-7 d-flex flex-column position-relative info-container">
                <div class="item-background animate__animated animate__slideInLeft"></div>
                <dl class="row position-absolute item-info animate__animated animate__slideInRight text-white">
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Koi.Name)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Koi.Name)</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Koi.Type)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Koi.Type)</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Koi.Variety)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Koi.Variety)</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Koi.DateOfBirth)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Koi.DateOfBirth)</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Koi.Size)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Koi.Size)</dd>

                    <dt class="col-sm-4">Chủ sở hữu</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Koi.User.FullName)</dd>
                </dl>

                <div class="animate__animated animate__slideInUp action-buttons">
                    <form method="post" asp-page-handler="GoToRefereeMarkPage" class="d-inline">
                        <input type="hidden" asp-for="KoiId" />
                        <input type="hidden" asp-for="RoundId" />
                        <input type="hidden" asp-for="CompetitionCategoryId" />
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-star me-2"></i>Chấm điểm
                        </button>
                    </form>
                    <a class="btn btn-secondary" asp-page="./Index">
                        <i class="fas fa-arrow-left me-2"></i>Quay lại danh sách
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

@page
@model KoiManagement_GUI.Pages.CategoryPages.EditModel

@{
    ViewData["Title"] = "Edit Category";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container my-5">
    <h1 class="text-center mb-4">Edit Category</h1>
    <h4>Category Details</h4>
    <hr />

    <div class="row justify-content-center">
        <div class="col-md-6">
            <form method="post" class="shadow p-4 rounded bg-light">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Category Name -->
                <div class="mb-3">
                    <label asp-for="Category.Name" class="form-label fw-bold"></label>
                    <input asp-for="Category.Name" class="form-control" />
                    <span asp-validation-for="Category.Name" class="text-danger"></span>
                </div>

                <!-- Category Size -->
                <div class="mb-3">
                    <label asp-for="Category.Size" class="form-label fw-bold"></label>
                    <input asp-for="Category.Size" class="form-control" />
                    <span asp-validation-for="Category.Size" class="text-danger"></span>
                </div>

                <!-- Category Variety -->
                <div class="mb-3">
                    <label asp-for="Category.Variety" class="form-label fw-bold"></label>
                    <input asp-for="Category.Variety" class="form-control" />
                    <span asp-validation-for="Category.Variety" class="text-danger"></span>
                </div>

                <!-- Category Age -->
                <div class="mb-3">
                    <label asp-for="Category.Age" class="form-label fw-bold"></label>
                    <input asp-for="Category.Age" class="form-control" />
                    <span asp-validation-for="Category.Age" class="text-danger"></span>
                </div>

                <!-- Active Status -->
                <div class="form-group form-check mb-3">
                    <input class="form-check-input" asp-for="Category.Active" />
                    <label asp-for="Category.Active" class="form-check-label fw-bold ms-2">
                        Active
                    </label>
                </div>

                <!-- Submit Button -->
                <div class="d-flex justify-content-between align-items-center">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save-fill me-1"></i>Save
                    </button>
                    <a asp-page="./Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left-circle me-1"></i>Back to List
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

@page
@model KoiManagement_GUI.Pages.CompetitionCategoryPages.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>CompetitionCategory</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Competition dropdown -->
            <div class="form-group">
                <label class="control-label">Competition</label>
                <select asp-for="CompetitionId" class="form-control" asp-items="Model.Competitions"></select>
            </div>

            <!-- Checkbox list for categories -->
            <div class="form-group">
                <label class="control-label">Categories</label>
                <div>
                    @foreach (var category in Model.Categories)
                    {
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" asp-for="SelectedCategoryIds" value="@category.Id" />
                            <label class="form-check-label">@category.Name</label>
                        </div>
                    }
                </div>
            </div>

            <!-- Active toggle -->
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Active" /> @Html.DisplayNameFor(model => model.Active)
                </label>
            </div>

            <!-- Submit button -->
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

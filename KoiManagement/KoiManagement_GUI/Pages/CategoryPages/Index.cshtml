@page
@model KoiManagement_GUI.Pages.CategoryPages.IndexModel

@{
    ViewData["Title"] = "Categories";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container my-5">
    <h1 class="text-center mb-4">Category Management</h1>

    <p class="text-end">
        <a asp-page="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle-fill me-1"></i>Create New Category
        </a>
    </p>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.Category[0].Name)</th>
                <th>@Html.DisplayNameFor(model => model.Category[0].Size)</th>
                <th>@Html.DisplayNameFor(model => model.Category[0].Variety)</th>
                <th>@Html.DisplayNameFor(model => model.Category[0].Age)</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Category)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Name)</td>
                    <td>@Html.DisplayFor(modelItem => item.Size)</td>
                    <td>@Html.DisplayFor(modelItem => item.Variety)</td>
                    <td>@Html.DisplayFor(modelItem => item.Age)</td>
                    <td>
                        <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm me-1">
                            <i class="bi bi-pencil-fill"></i> Edit
                        </a>
                        <a href="javascript:void(0);" onclick="confirmDelete('@item.Id')" class="btn btn-sm btn-outline-danger">Delete</a>
                        <form id="deleteForm" method="post">
                            <input type="hidden" asp-for="@item.Id" />
                            <input type="submit" value="Delete" class="btn btn-danger" style="display: none;" />
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@section Scripts {
    <script type="text/javascript">
        function confirmDelete(id) {
            if (confirm("Are you sure you want to delete this item?")) {
                // Set the form action to submit the delete request for the specific item
                var form = document.getElementById('deleteForm');
                form.action = '@Url.Page("./Delete")' + "?id=" + id;
                form.submit(); // Submit the form
            }
        }
    </script>
}


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />

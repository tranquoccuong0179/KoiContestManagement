@page
@using KoiManagement_BusinessObjects.Constants
@model KoiManagement_GUI.Pages.ProfilePages.IndexModel
@{
	if (HttpContext.Session.GetString("Id") is null)
	{
		Response.Redirect("/LoginPage");
	}
	string successMessage = ViewData["SuccessMessage"] as string;
	string role = HttpContext.Session.GetString("Role");
}
<head>
	<link rel="stylesheet" href="~/css/ProfilePageIndex.css" asp-append-version="true" />
</head>

<div id="profile">
	<div class="container">
		@if (!string.IsNullOrEmpty(successMessage))
		{
			<div class="alert alert-success alert-dismissible fade show" role="alert">
				@Html.Raw(successMessage)
				<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
			</div>
		}
		<div class="row">
			<div class="col-4 d-flex justify-content-center align-items-center rounded-pill">
				<button class="btn animate__animated animate__rotateInDownLeft rounded-pill">
					<img src="https://media.istockphoto.com/vectors/default-profile-picture-avatar-photo-placeholder-vector-illustration-vector-id1223671392?k=6&m=1223671392&s=170667a&w=0&h=zP3l7WJinOFaGb2i1F4g8IS2ylw0FlIaa6x3tP9sebU=" height="150" width="150" style="background-color: transparent" />
				</button>
			</div>
			<div class="col-8 position-relative d-flex flex-column">
				<div class="rounded-pill animate__animated animate__slideInLeft item-background">
				</div>
				<div class="position-absolute animate__animated animate__slideInRight item-info">
					<div class="mt-3 animate__animated animate__rotateInDownLeft text-white">Name: <span class="fw-bold">@Model.User.FullName</span></div>
					<div class="mt-3 animate__animated animate__rotateInDownLeft text-white">Role: <span class="fw-bold"> @HttpContext.Session.GetString("Role")</span></div>
					<div class="rounded mt-3 date animate__animated animate__rotateInUpRight text-white">
						Joined: <span class="fw-bold">@Model.User.CreateAt</span>
					</div>
					<div class=" d-flex mt-3 animate__animated animate__rotateInUpLeft">
						<a asp-page="UpdateProfilePage" class="btn btn-primary me-2">Edit profile</a>
						<a asp-page="UpdatePasswordPage" class="btn btn-primary me-2">Change password</a>
						@{
							if (role == Role.Contestant)
							{
								<a asp-page="/KoiPages/Index" class="btn btn-primary animate__animated animate__rotateInUpRight">Manage your kois</a>
							}
						}
					</div>

				</div>

			</div>
		</div>

	</div>
</div>

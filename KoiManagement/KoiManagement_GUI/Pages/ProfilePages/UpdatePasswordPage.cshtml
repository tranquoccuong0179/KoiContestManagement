@page
@model KoiManagement_GUI.Pages.ProfilePages.UpdatePasswordPageModel
@{
}

<head>
	<link href="~/css/UpdatePasswordPage.css" asp-append-version="true" rel="stylesheet" />
</head>

<div class="form-body">
	<div class="row">
		<div class="form-holder">
			<div class="form-content">
				<div class="form-items">
					<h3>Change password</h3>
					<form class="requires-validation" method="post">

						<div class="col-md-12">
							<input class="form-control" type="password" placeholder="Current password" asp-for="UserForUpdatePasswordDto.OldPassword">
							<span asp-validation-for="UserForUpdatePasswordDto.OldPassword" class="text-danger"></span>
						</div>

						<div class="col-md-12">
							<input class="form-control" type="password" placeholder="New password" asp-for="UserForUpdatePasswordDto.NewPassword">
							<span asp-validation-for="UserForUpdatePasswordDto.NewPassword" class="text-danger"></span>
						</div>


						<div class="col-md-12">
							<input class="form-control" type="password" placeholder="Confirm password" asp-for="UserForUpdatePasswordDto.ConfirmPassword">
							<span asp-validation-for="UserForUpdatePasswordDto.ConfirmPassword" class="text-danger"></span>
						</div>

						<div class="form-button mt-3 d-flex justify-content-center">
							<button type="submit" class="btn btn-primary">Change</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>


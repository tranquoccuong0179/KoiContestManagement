@page
@model KoiManagement_GUI.Pages.RegistrationPages.IndexModel

@{
    ViewData["Title"] = "Index";
    var userRole = HttpContext.Session.GetString("Role");
}

<h1>Index</h1>

<p>
    <a asp-page="/CompetitionPages/Index">Sign up for another competition</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Registration[0].IsCheckIn)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Registration[0].CheckInTime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Registration[0].CompetitionCategory)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Registration[0].Koi)
            </th>
            @if (userRole == "Admin")
            {
                <th>
                    @Html.DisplayNameFor(model => model.Registration[0].Active)
                </th>
            }          
            <th>
                @Html.DisplayNameFor(model => model.Registration[0].CreateAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Registration[0].UpdateAt)
            </th>
            @if (userRole == "Admin")
            {
                <th>
                    @Html.DisplayNameFor(model => model.Registration[0].DeleteAt)
                </th>
            }           
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Registration) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.IsCheckIn)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CheckInTime)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CompetitionCategory.Category.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Koi.Name)
            </td>
                @if (userRole == "Admin")
                {
                    <td>
                        @Html.DisplayFor(modelItem => item.Active)
                    </td>
                }           
            <td>
                @Html.DisplayFor(modelItem => item.CreateAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UpdateAt)
            </td>
                @if (userRole == "Admin")
                {
                    <td>
                        @Html.DisplayFor(modelItem => item.DeleteAt)
                    </td>
                }
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

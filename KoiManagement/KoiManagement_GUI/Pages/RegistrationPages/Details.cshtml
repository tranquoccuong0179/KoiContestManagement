@page
@model KoiManagement_GUI.Pages.RegistrationPages.DetailsModel

@{
    ViewData["Title"] = "Details";
    var userRole = HttpContext.Session.GetString("Role");
}

<style>
    /* Định dạng cho các phần tử bên trong */
    .content-wrapper {
        margin: 20px;
    }

    /* Định dạng các mục chi tiết */
    dl.row {
        margin: 20px 0;
    }

        dl.row dt {
            font-weight: bold;
            color: #405c54;
            font-size: 1.1rem;
        }

        /* Định dạng phần hiển thị các giá trị */
        dl.row dd {
            background-color: #ffffff;
            padding: 10px;
            border: 1px solid #ccc;
            margin-bottom: 10px;
            border-radius: 5px;
            color: #333;
            margin-left: 10px; /* Thêm khoảng cách từ bên trái */
        }

    /* Định dạng cho các liên kết */
    a {
        color: #405c54;
        text-decoration: none;
        font-weight: bold;
        margin-right: 10px;
    }

        a:hover {
            color: #2a4b44; /* Sử dụng màu đậm hơn khi hover */
        }

    /* Định dạng cho các ô phân cách */
    hr {
        border-top: 2px solid #405c54;
        width: 100%;
        margin: 10px 0;
    }

    /* Định dạng các nút "Edit" và "Back to List" */
    .btn {
        display: inline-block;
        padding: 10px 20px;
        font-size: 1rem;
        font-weight: bold;
        text-align: center;
        text-decoration: none;
        border-radius: 5px;
        margin-right: 10px;
        cursor: pointer;
        transition: background-color 0.3s ease, transform 0.2s ease;
    }

    /* Nút "Edit" */
    .btn-edit {
        background-color: #405c54;
        color: white;
        border: 1px solid #405c54;
    }

        .btn-edit:hover {
            background-color: #2a4b44;
            border-color: #2a4b44;
            transform: scale(1.05);
        }

    /* Nút "Back to List" */
    .btn-back {
        background-color: #ffffff;
        color: #405c54;
        border: 1px solid #405c54;
    }

        .btn-back:hover {
            background-color: #405c54;
            color: white;
            border-color: #405c54;
            transform: scale(1.05);
        }
</style>

<div class="content-wrapper">
    <h1>Details</h1>

    <div>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Registration.IsCheckIn)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Registration.IsCheckIn)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Registration.CheckInTime)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Registration.CheckInTime)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Registration.CompetitionCategory)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Registration.CompetitionCategory.Category.Name)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Registration.Koi)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Registration.Koi.Name)
            </dd>
            @if (userRole == "Admin")
            {
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Registration.Active)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Registration.Active)
                </dd>
            }
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Registration.CreateAt)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Registration.CreateAt)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Registration.UpdateAt)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Registration.UpdateAt)
            </dd>
            @if (userRole == "Admin")
            {
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Registration.DeleteAt)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Registration.DeleteAt)
                </dd>
            }
        </dl>
    </div>

    <div>
        <a class="btn btn-back" asp-page="./Index">Back to List</a>
    </div>
</div>

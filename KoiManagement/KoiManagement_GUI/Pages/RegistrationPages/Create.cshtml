@page
@model KoiManagement_GUI.Pages.RegistrationPages.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1 class="text-center" style="color: #3b5d50;">Create</h1>

<h4 class="text-center" style="color: #3b5d50;">Registration</h4>
<hr />

<div class="row justify-content-center">
    <div class="col-md-6">
        <form method="post" class="shadow p-4 rounded" style="background-color: #f9f9f9;">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Koi Name Dropdown -->
            <div class="form-group">
                <label asp-for="Registration.KoiId" class="control-label" style="color: #3b5d50;">Koi Name</label>
                <select asp-for="Registration.KoiId" class="form-control" asp-items="ViewBag.KoiId" style="border-color: #3b5d50;"></select>
            </div>

            <!-- Category Dropdown -->
            <div class="form-group mt-3">
                <label asp-for="Registration.CompetitionCategoryId" class="control-label" style="color: #3b5d50;">Category</label>
                <select asp-for="Registration.CompetitionCategoryId" class="form-control" asp-items="ViewBag.CompetitionCategoryId" style="border-color: #3b5d50;"></select>
            </div>

            <!-- Submit Button -->
            <div class="form-group mt-4">
                <input type="submit" value="Create" class="btn btn-primary w-100" style="background-color: #3b5d50; border-color: #3b5d50;" />
            </div>
        </form>
    </div>
</div>

<!-- Back to List Link -->
<div class="text-center mt-3">
    <a asp-page="Index" class="btn btn-secondary" style="background-color: #3b5d50; border-color: #3b5d50;">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<!-- Inline CSS -->
<style>
    /* Tạo hiệu ứng hover cho nút */
    input[type="submit"]:hover {
        background-color: #2c4c3a;
        border-color: #2c4c3a;
    }

    /* Tạo hiệu ứng focus cho các trường select */
    select.form-control:focus {
        border-color: #2c4c3a;
        box-shadow: 0 0 0 0.2rem rgba(59, 93, 80, 0.25);
    }

    /* Tạo bóng cho form */
    form {
        background-color: #fff;
        border-radius: 8px;
        padding: 20px;
    }

    /* Thêm màu cho tiêu đề */
    h1 {
        color: #3b5d50;
        font-weight: 600;
    }

    /* Căn giữa và điều chỉnh khoảng cách cho các nút */
    .btn {
        margin-top: 10px;
    }

    .btn-primary {
        background-color: #3b5d50;
        border-color: #3b5d50;
    }

    /* Hiệu ứng cho nút Back to List */
    .btn-secondary:hover {
        background-color: #2c4c3a;
        border-color: #2c4c3a;
    }

    /* Tạo hiệu ứng hover cho các trường select */
    select.form-control:hover {
        border-color: #2c4c3a;
    }
</style>

@page
@model KoiManagement_GUI.Pages.DashboardPages.IndexModel
@{
}

<head>
	<link id="pagestyle" href="~/css/Dashboard.css" rel="stylesheet" asp-append-version="true" />
</head>

<div class="container-xxl position-relative bg-white d-flex p-0">
	<!-- Sidebar Start -->
	<div class="sidebar pe-4 pb-3">
		<nav class="navbar bg-light navbar-light">
			<a href="index.html" class="navbar-brand mx-4 mb-3">
				<h3 class="text-success"><i class="fa fa-hashtag me-2"></i>DASHMIN</h3>
			</a>
			<div class="d-flex align-items-center ms-4 mb-4">
				<div class="position-relative">
					<img class="rounded-circle" src="https://media.istockphoto.com/vectors/default-profile-picture-avatar-photo-placeholder-vector-illustration-vector-id1223671392?k=6&m=1223671392&s=170667a&w=0&h=zP3l7WJinOFaGb2i1F4g8IS2ylw0FlIaa6x3tP9sebU=" alt="" style="width: 40px; height: 40px;">
					<div class="bg-success rounded-circle border border-2 border-white position-absolute end-0 bottom-0 p-1"></div>
				</div>
				<div class="ms-3">
					<h6 class="mb-0">@HttpContext.Session.GetString("FullName")</h6>
					<span>@HttpContext.Session.GetString("Role")</span>
				</div>
			</div>
			<div class="navbar-nav w-100">
				<a asp-page="/DashboardPages/Index" class="nav-item nav-link "><i class="fa fa-tachometer-alt me-2"></i>Kois</a>
				<a asp-page="/DashboardPages/Users" class="nav-item nav-link "><i class="fa fa-table me-2"></i>Users</a>
			</div>
		</nav>
	</div>
	<!-- Sidebar End -->
	<!-- Content Start -->
	<div class="content">
		<!-- Table Start -->
		<div class="container-fluid pt-4 px-4">
			<div class="row g-4">
				<div class="col-12">
					<div class="bg-light rounded h-100">
						<h3 class="mb-4">Koi Management</h3>
						<div class="table-responsive">
							<table class="table">
								<thead>
									<tr>
										<th scope="col">#</th>
										<th scope="col">Name</th>
										<th scope="col">Type</th>
										<th scope="col">Variety</th>
										<th scope="col">DateOfBirth</th>
										<th scope="col">Status</th>
										<th scope="col">Size</th>
										<th scope="col">Image</th>
										<th scope="col">Owner</th>
									</tr>
								</thead>
								<tbody>
									@{
										for (int i = 0; i < Model.KoiList.Count(); i++)
										{
											var koi = Model.KoiList[i];
											<tr>
												<th scope="row">@(i + 1)</th>
												<td>@koi.Name</td>
												<td>@koi.Type</td>
												<td>@koi.Variety</td>
												<td>@koi.DateOfBirth</td>
												<td>
													@{
														if (koi.Active)
														{
															<span class="badge rounded-pill bg-success">Active</span>
														}
														else
														{
															<span class="badge rounded-pill bg-danger">Inactive</span>
														}
													}
												</td>
												<td>@koi.Size</td>
												<td><img src="@koi.Image" style="width:60px;height:60px" /></td>
												<td>@koi.User.FullName</td>
											</tr>
										}
									}
								</tbody>
							</table>
						</div>
					</div>
				</div>
			</div>
		</div>
		<!-- Table End -->
	</div>
	<!-- Content End -->
</div>
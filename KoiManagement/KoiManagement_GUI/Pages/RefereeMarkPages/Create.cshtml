@page
@model KoiManagement_GUI.Pages.RefereeMarkPages.CreateModel

@{
    ViewData["Title"] = "Create RefereeMark";
}

<h1>Create RefereeMark</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- User Selection -->
            <div class="form-group">
                <label asp-for="RefereeMark.UserId" class="control-label"></label>
                <select asp-for="RefereeMark.UserId" class="form-control" asp-items="ViewBag.UserId"></select>
            </div>

            <!-- Competition Round Selection -->
            <div class="form-group">
                <label asp-for="RefereeMark.CompetitionRoundId" class="control-label"></label>
                <select asp-for="RefereeMark.CompetitionRoundId" class="form-control" asp-items="ViewBag.CompetitionRoundId"></select>
            </div>

            <!-- Dynamic Inputs for Criteria Points -->
            @for (int i = 0; i < Model.RefereeMark.CriteriaPoints.Count; i++)
            {
                var criteriaPoint = Model.RefereeMark.CriteriaPoints[i];
                var criteriaName = Model.Criterias.FirstOrDefault(c => c.Id == criteriaPoint.CriteriaId)?.Name ?? "Unknown Criteria";

                <div class="form-group">
                    <label class="control-label">@criteriaName</label>
                    <input asp-for="RefereeMark.CriteriaPoints[i].Point" class="form-control" />
                    <input type="hidden" asp-for="RefereeMark.CriteriaPoints[i].CriteriaId" />
                    <span asp-validation-for="RefereeMark.CriteriaPoints[i].Point" class="text-danger"></span>
                </div>
            }

            <!-- Submit Button -->
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

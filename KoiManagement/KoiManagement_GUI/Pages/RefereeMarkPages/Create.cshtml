@page
@model KoiManagement_GUI.Pages.RefereeMarkPages.CreateModel

@{
    ViewData["Title"] = "Create RefereeMark";
}

<head>
    <link href="~/css/UpdatePasswordPage.css" asp-append-version="true" rel="stylesheet" />
</head>

<div class="form-body">
    <div class="row">
        <div class="form-holder">
            <div class="form-content">
                <div class="form-items">
                    <h3 class="d-flex justify-content-center animate__animated animate__backInDown">Create RefereeMark</h3>
                    <form class="requires-validation" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <!-- User Selection -->
                        <div class="col-md-12 form-group animate__animated animate__backInLeft">
                            <label asp-for="RefereeMark.UserId" class="control-label"></label>
                            <select asp-for="RefereeMark.UserId" class="form-control" asp-items="ViewBag.UserId"></select>
                            <span asp-validation-for="RefereeMark.UserId" class="text-danger"></span>
                        </div>

                        <!-- Competition Round Selection -->
                        <div class="col-md-12 form-group animate__animated animate__backInLeft">
                            <label asp-for="RefereeMark.CompetitionRoundId" class="control-label"></label>
                            <select asp-for="RefereeMark.CompetitionRoundId" class="form-control" asp-items="ViewBag.CompetitionRoundId"></select>
                            <span asp-validation-for="RefereeMark.CompetitionRoundId" class="text-danger"></span>
                        </div>

                        <!-- Dynamic Inputs for Criteria Points -->
                        @for (int i = 0; i < Model.RefereeMark.CriteriaPoints.Count; i++)
                        {
                            var criteriaPoint = Model.RefereeMark.CriteriaPoints[i];
                            var criteriaName = Model.Criterias.FirstOrDefault(c => c.Id == criteriaPoint.CriteriaId)?.Name ?? "Unknown Criteria";

                            <div class="col-md-12 form-group animate__animated animate__backInLeft">
                                <label class="control-label">@criteriaName</label>
                                <input asp-for="RefereeMark.CriteriaPoints[i].Point" class="form-control" />
                                <input type="hidden" asp-for="RefereeMark.CriteriaPoints[i].CriteriaId" />
                                <span asp-validation-for="RefereeMark.CriteriaPoints[i].Point" class="text-danger"></span>
                            </div>
                        }

                        <!-- Submit Button -->
                        <div class="form-button mt-3 d-flex justify-content-center animate__animated animate__backInUp">
                            <input type="submit" value="Create" class="btn btn-primary mt-2" />
                        </div>
                    </form>

                    <!-- Back Button -->
                    <div class="mt-3 d-flex justify-content-center animate__animated animate__backInUp">
                        <a asp-page="Index" class="btn btn-primary mt-2">Back to List</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

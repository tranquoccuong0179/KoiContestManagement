@page
@model KoiManagement_GUI.Pages.RefereeMarkPages.DetailsModel

@{
    ViewData["Title"] = "Referee Mark Details";
}

<h1 class="page-title">Referee Mark Details</h1>

<div class="details-container shadow-lg p-4 mb-4 bg-white rounded">
    <h4 class="section-title">Referee Mark Information</h4>
    <hr class="section-divider" />
    <dl class="row details-list">
        <dt class="col-sm-3 detail-label">
            @Html.DisplayNameFor(model => model.RefereeMark.Point)
        </dt>
        <dd class="col-sm-9 detail-value">
            @Html.DisplayFor(model => model.RefereeMark.Point)
        </dd>

        <dt class="col-sm-3 detail-label">
            @Html.DisplayNameFor(model => model.RefereeMark.CompetitionRound.Koi.Name)
        </dt>
        <dd class="col-sm-9 detail-value">
            @Html.DisplayFor(model => model.RefereeMark.CompetitionRound.Koi.Name)
        </dd>

        <dt class="col-sm-3 detail-label">
            @Html.DisplayNameFor(model => model.RefereeMark.User.FullName)
        </dt>
        <dd class="col-sm-9 detail-value">
            @Html.DisplayFor(model => model.RefereeMark.User.FullName)
        </dd>
    </dl>
</div>

<div class="action-buttons mt-4">
    <a asp-page="./Index" class="btn btn-primary">Back to List</a>
</div>

<style>
    .page-title {
        font-size: 2rem;
        color: #333;
        text-align: center;
        margin-bottom: 1.5rem;
    }

    .details-container {
        max-width: 800px;
        margin: auto;
        padding: 2rem;
        border: 1px solid #ddd;
        background-color: #f9f9f9;
        border-radius: 8px;
    }

    .section-title {
        font-size: 1.5rem;
        color: #555;
        margin-bottom: 1rem;
    }

    .section-divider {
        border-top: 2px solid #e0e0e0;
    }

    .details-list dt.detail-label {
        font-weight: bold;
        color: #666;
    }

    .details-list dd.detail-value {
        margin-bottom: 1rem;
        color: #333;
    }

    .action-buttons {
        text-align: center;
    }

        .action-buttons .btn {
            font-size: 1rem;
            padding: 0.5rem 1.5rem;
            border-radius: 4px;
        }
</style>

@page
@model KoiManagement_GUI.Pages.RefereeMarkPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Referee Mark Page</h1>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.RefereeMark[0].Point)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RefereeMark[0].CompetitionRound.Koi.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RefereeMark[0].User)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.RefereeMark) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Point)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CompetitionRound.Koi.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.User.FullName)
            </td>
            <td>
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a>
            </td>
        </tr>
}
    </tbody>
</table>

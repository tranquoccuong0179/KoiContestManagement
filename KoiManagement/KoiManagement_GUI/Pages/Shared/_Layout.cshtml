<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - KoiManagement_GUI</title>
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/KoiManagement_GUI.styles.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/LoginPage.css" asp-append-version="true" />
	<link href="~/css/UpdatePasswordPage.css" asp-append-version="true	" />
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

</head>
<body>
	@{
		if (Context.Session.GetString("Id") is not null)
		{
			<header class="mb-3">
				<nav class="header navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom box-shadow">
					<div class="container">
						<a class="navbar-brand text-white" asp-area="" asp-page="/Index">KoiManagement_GUI</a>
						<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
								aria-expanded="false" aria-label="Toggle navigation">
							<span class="navbar-toggler-icon"></span>
						</button>
						<div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
							<ul class="navbar-nav flex-grow-1">
								<li class="nav-item">
									<a class="nav-link text-white" asp-area="" asp-page="/Index">Home</a>
								</li>
								<li class="nav-item">
									<a class="nav-link text-white" asp-area="" asp-page="/Privacy">Privacy</a>
								</li>
							</ul>
							<div class="btn-group">
								<button class="btn dropdown-toggle text-white" type="button" data-bs-toggle="dropdown" aria-expanded="false">
									Welcome <span class="fst-italic text-danger me-1">
										@{
											@Html.Raw(Context.Session.GetString("FullName"))
										}
									</span>
								</button>
								<ul class="dropdown-menu">
									<li><a asp-page="/ProfilePages/Index" class="dropdown-item">Profile</a></li>
									<li><a asp-page="/LogoutPage" class="dropdown-item">Logout</a></li>
								</ul>
							</div>
						</div>
					</div>
				</nav>
			</header>
		}
	}
	<div class="main">
		<main role="main" class="w-100 h-100">
			@RenderBody()
		</main>
	</div>

	@{
		if (Context.Session.GetString("Id") is not null)
		{
			<footer class="border-top footer text-muted">
				<div class="container text-white">
					&copy; 2021 - KoiManagement_GUI - <a asp-area="" asp-page="/Privacy">Privacy</a>
				</div>
			</footer>
		}

	}

	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>

	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
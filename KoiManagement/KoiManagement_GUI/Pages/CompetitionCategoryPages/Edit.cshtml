@page
@model KoiManagement_GUI.Pages.CompetitionCategoryPages.EditModel
@{
    ViewData["Title"] = "Edit Competition Categories";
}

<h1>Edit Competition Categories</h1>

<h4>Competition: @Model.CompetitionName</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post" asp-page-handler="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="CompetitionId" />

            <div class="form-group">
                <label class="control-label">Category</label>
                @foreach (var category in Model.Categories)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="SelectedCategoryIds" value="@category.Id"
                        @(Model.SelectedCategoryIds.Contains(category.Id) ? "checked" : "") />
                        <label class="form-check-label">@category.Name</label>
                    </div>
                }
            </div>
            <div class="form-group">
                <input type="submit" value="Save Changes" class="btn btn-primary" />
            </div>
        </form>

        <form method="post" asp-page-handler="Delete">
            <input type="hidden" asp-for="CompetitionId" />
            <button type="submit" class="btn btn-danger">Delete All Categories</button>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

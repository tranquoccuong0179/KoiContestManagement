@page
@model KoiManagement_GUI.Pages.CompetitionCategoryPages.CreateModel

@{
    ViewData["Title"] = "Create Competition Categories";
}

<h1>Create Competition Categories</h1>

<h4>Competition: @Model.CompetitionName</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Hidden field for CompetitionId -->
            <input type="hidden" asp-for="CompetitionId" />

            <!-- Display checkboxes for categories -->
            <div class="form-group">
                <label class="control-label">Category</label>
                @foreach (var category in Model.Categories)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="SelectedCategoryIds" value="@category.Id" />
                        <label class="form-check-label">@category.Name</label>
                    </div>
@*                     <label class="form-check-label">
                        <input class="form-check-input" asp-for="@category.CompetitionCategories." />
                        @Html.DisplayNameFor(model => model.CompetitionCategory.Active)
                    </label> *@
                }
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

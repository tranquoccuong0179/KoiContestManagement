@page
@model KoiManagement_GUI.Pages.CompetitionCategoryPages.CreateModel

@{
    ViewData["Title"] = "Create Competition Categories";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container my-5">
    <h1 class="text-center mb-4">Create Competition Categories</h1>

    <h4 class="text-center mb-4">Competition: @Model.CompetitionName</h4>
    <hr />

    <div class="row justify-content-center">
        <div class="col-md-6">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Hidden Competition ID -->
                <input type="hidden" asp-for="CompetitionId" />

                <!-- Category Selection -->
                <div class="form-group mb-4">
                    <label class="control-label">Categories</label>
                    <div class="mt-2">
                        @foreach (var category in Model.Categories)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="SelectedCategoryIds" value="@category.Id" />
                                <label class="form-check-label">@category.Name</label>
                            </div>
                        }
                    </div>
                </div>

                <!-- Submit Button -->
                <div class="form-group text-center">
                    <input type="submit" value="Create" class="btn btn-primary btn-lg" />
                </div>
            </form>
        </div>
    </div>

    <!-- Back Link -->
    <div class="mt-4 text-center">
        <a asp-page="Index" class="btn btn-outline-secondary">Back to List</a>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

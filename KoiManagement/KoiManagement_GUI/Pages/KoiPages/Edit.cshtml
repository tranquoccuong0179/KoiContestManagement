@page
@model KoiManagement_GUI.Pages.KoiPages.EditModel

@{
	ViewData["Title"] = "Edit";
	if (HttpContext.Session.GetString("Id") is null)
	{
		Response.Redirect("/LoginPage");
	}
}

<div class="container">
	<h1>Edit</h1>

	<h4>Koi</h4>
	<hr />
	<div class="row">
		<div class="col-md-4">
			<form method="post" enctype="multipart/form-data">
				<div asp-validation-summary="ModelOnly" class="text-danger"></div>
				<div class="form-group">
					<input asp-for="Koi.Id" class="form-control" type="hidden" />
				</div>
				<div class="form-group">
					<label asp-for="Koi.Name" class="control-label"></label>
					<input asp-for="Koi.Name" class="form-control" />
					<span asp-validation-for="Koi.Name" class="text-danger"></span>
				</div>
				<div class="form-group">
					<label asp-for="Koi.Type" class="control-label"></label>
					<input asp-for="Koi.Type" class="form-control" />
					<span asp-validation-for="Koi.Type" class="text-danger"></span>
				</div>
				<div class="form-group">
					<label asp-for="Koi.Variety" class="control-label"></label>
					<input asp-for="Koi.Variety" class="form-control" />
					<span asp-validation-for="Koi.Variety" class="text-danger"></span>
				</div>
				<div class="form-group">
					<label asp-for="Koi.DateOfBirth" class="control-label"></label>
					<input asp-for="Koi.DateOfBirth" class="form-control" />
					<span asp-validation-for="Koi.DateOfBirth" class="text-danger"></span>
				</div>
				<div class="form-group">
					<label asp-for="Koi.Size" class="control-label"></label>
					<input asp-for="Koi.Size" class="form-control" />
					<span asp-validation-for="Koi.Size" class="text-danger"></span>
				</div>
				<div class="form-group">
					<label asp-for="Koi.File" class="control-label"></label>
					<input asp-for="Koi.File" class="form-control" />
					<span asp-validation-for="Koi.File" class="text-danger"></span>
				</div>
				<div class="form-group">
					<input asp-for="Koi.UserId" class="form-control" type="hidden" />
				</div>
				<div class="form-group">
					<input type="submit" value="Save" class="btn btn-primary" />
				</div>
			</form>
		</div>
	</div>

	<div>
		<a asp-page="./Index" class="btn btn-primary">Back to List</a>
	</div>
</div>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}

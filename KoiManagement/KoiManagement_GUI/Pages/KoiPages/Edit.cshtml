@page
@model KoiManagement_GUI.Pages.KoiPages.EditModel

@{
	ViewData["Title"] = "Edit";
	if (HttpContext.Session.GetString("Id") is null)
	{
		Response.Redirect("/LoginPage");
	}
}

<head>
	<link href="~/css/UpdatePasswordPage.css" asp-append-version="true" rel="stylesheet" />
</head>

<div class="form-body">
	<div class="row">
		<div class="form-holder">
			<div class="form-content">
				<div class="form-items">
					<h3 class="d-flex justify-content-center animate__animated animate__backInDown">Edit Koi</h3>
					<form class="requires-validation" method="post" enctype="multipart/form-data">
						<div asp-validation-summary="ModelOnly" class="text-danger"></div>
						<div class="col-md-12 form-group">
							<input asp-for="Koi.Id" class="form-control" type="hidden" />
						</div>
						<div class="col-md-12 form-group animate__animated animate__backInLeft">
							<input class="form-control" placeholder="Name" asp-for="Koi.Name">
							<span asp-validation-for="Koi.Name" class="text-danger"></span>
						</div>

						<div class="col-md-12 form-group animate__animated animate__backInLeft">
							<input class="form-control" placeholder="Type" asp-for="Koi.Type">
							<span asp-validation-for="Koi.Type" class="text-danger"></span>
						</div>

						<div class="col-md-12 form-group animate__animated animate__backInLeft">
							<input class="form-control" placeholder="Variety" asp-for="Koi.Variety">
							<span asp-validation-for="Koi.Variety" class="text-danger"></span>
						</div>

						<div class="col-md-12 form-group animate__animated animate__backInLeft">
							<input class="form-control" placeholder="Size" asp-for="Koi.Size">
							<span asp-validation-for="Koi.Size" class="text-danger"></span>
						</div>

						<div class="col-md-12 form-group mt-3 animate__animated animate__backInLeft">
							<input class="form-control" placeholder="DateOfBirth" asp-for="Koi.DateOfBirth">
							<span asp-validation-for="Koi.DateOfBirth" class="text-danger"></span>
						</div>

						<div class="col-md-12 form-group mt-3 animate__animated animate__backInLeft">
							<input class="form-control" placeholder="File" asp-for="Koi.File" type="file">
							<span asp-validation-for="Koi.File" class="text-danger"></span>
						</div>

						<div class="col-md-12 form-group">
							<input class="form-control" placeholder="UserId" type="hidden" asp-for="Koi.UserId">
						</div>

						<div class="form-button mt-3 d-flex justify-content-center animate__animated animate__backInUp">
							<input type="submit" value="Edit" class="btn btn-primary mt-2" />
						</div>
					</form>
					<div class="mt-3 d-flex justify-content-center animate__animated animate__backInUp">
						<a asp-page="Index" class="btn btn-primary mt-2">Back to List</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}

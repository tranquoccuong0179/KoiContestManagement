@page
@model KoiManagement_GUI.Pages.KoiPages.IndexModel

@{
	ViewData["Title"] = "Index";
	if (HttpContext.Session.GetString("Id") is null)
	{
		Response.Redirect("/LoginPage");
	}
}
<head>
	<link rel="stylesheet" href="~/css/KoiPagesIndex.css" asp-append-version="true" />
</head>

<div class="body-koi-index container">
	<div class="d-flex justify-content-between mb-5">

		<p>
			<a asp-page="Create" class="btn btn-primary animate__flipInX animate__animated">Create New</a>
		</p>
	</div>
	<div class="row">
		@foreach (var item in Model.Koi)
		{
			<div class="col-4 item d-flex justify-content-center animate__fadeInDownBig animate__animated">
				<div class="card" style="width: 18rem;">
					<img src="@item.Image" class="card-img-top" alt="@item.Id">
					<div class="card-body">
						<h5 class="card-title text-white">@item.Name</h5>
						<a class="btn btn-primary" asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
						<a class="btn btn-primary" asp-page="./Details" asp-route-id="@item.Id">Details</a> |
						<a class="btn btn-primary" asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
					</div>
				</div>
			</div>
		}
	</div>
</div>


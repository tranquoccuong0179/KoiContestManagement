@page
@model KoiManagement_GUI.Pages.KoiPages.DeleteModel

@{
	ViewData["Title"] = "Delete";
	if (HttpContext.Session.GetString("Id") is null)
	{
		Response.Redirect("/LoginPage");
	}
}

<div class="container">
	<h3 class="text-danger">Are you sure you want to delete @Model.Koi.Name?</h3>
	<div>
		<div>
			<div class="row">
				<div class="col-4">
					<img class="img-thumbnail rounded" src="@Html.DisplayFor(model => model.Koi.Image)" alt="@Html.DisplayFor(model => model.Koi.Id)" />
				</div>
				<div class="col-8 d-flex align-items-center">
					<dl class="row">
						<dt class="col-sm-2">
							@Html.DisplayNameFor(model => model.Koi.Name)
						</dt>
						<dd class="col-sm-10">
							@Html.DisplayFor(model => model.Koi.Name)
						</dd>
						<dt class="col-sm-2">
							@Html.DisplayNameFor(model => model.Koi.Type)
						</dt>
						<dd class="col-sm-10">
							@Html.DisplayFor(model => model.Koi.Type)
						</dd>
						<dt class="col-sm-2">
							@Html.DisplayNameFor(model => model.Koi.Variety)
						</dt>
						<dd class="col-sm-10">
							@Html.DisplayFor(model => model.Koi.Variety)
						</dd>
						<dt class="col-sm-2">
							@Html.DisplayNameFor(model => model.Koi.DateOfBirth)
						</dt>
						<dd class="col-sm-10">
							@Html.DisplayFor(model => model.Koi.DateOfBirth)
						</dd>
						<dt class="col-sm-2">
							@Html.DisplayNameFor(model => model.Koi.Size)
						</dt>
						<dd class="col-sm-10">
							@Html.DisplayFor(model => model.Koi.Size)
						</dd>
						<dt class="col-sm-2">
							@Html.Raw("Owner")
						</dt>
						<dd class="col-sm-10">
							@Html.DisplayFor(model => model.Koi.User.FullName)
						</dd>
					</dl>
				</div>
			</div>
		</div>

		<form method="post" class="mt-3">
			<input type="hidden" asp-for="Koi.Id" />
			<input type="submit" value="Delete" class="btn btn-danger" /> |
			<a asp-page="./Index" class="btn btn-primary">Back to List</a>
		</form>
	</div>
</div>

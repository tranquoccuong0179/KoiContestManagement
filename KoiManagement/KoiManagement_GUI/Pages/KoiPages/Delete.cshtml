@page
@model KoiManagement_GUI.Pages.KoiPages.DeleteModel

@{
	ViewData["Title"] = "Delete";
	if (HttpContext.Session.GetString("Id") is null)
	{
		Response.Redirect("/LoginPage");
	}
}

<head>
	<style>
		.item-background {
			background-color: #ffcc99;
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
		}

		.item-info {
			left: 25%
		}
	</style>
</head>

<div class="container">
	<h3 class="text-danger animate__animated animate__slideInLeft">Are you sure you want to delete @Model.Koi.Name?</h3>
	<div>
		<div>
			<div class="row">
				<div class="col-4 animate__zoomInLeft animate__animated">
					<img class="img-thumbnail rounded" src="@Html.DisplayFor(model => model.Koi.Image)" alt="@Html.DisplayFor(model => model.Koi.Id)" />
				</div>
				<div class="col-8 d-flex flex-column position-relative">
					<div class="item-background rounded-pill animate__animated animate__slideInLeft">
					</div>
					<dl class="row position-absolute animate__animated animate__zoomInRight item-info">
						<dt class="col-sm-2">
							@Html.DisplayNameFor(model => model.Koi.Name)
						</dt>
						<dd class="col-sm-10">
							@Html.DisplayFor(model => model.Koi.Name)
						</dd>
						<dt class="col-sm-2">
							@Html.DisplayNameFor(model => model.Koi.Type)
						</dt>
						<dd class="col-sm-10">
							@Html.DisplayFor(model => model.Koi.Type)
						</dd>
						<dt class="col-sm-2">
							@Html.DisplayNameFor(model => model.Koi.Variety)
						</dt>
						<dd class="col-sm-10">
							@Html.DisplayFor(model => model.Koi.Variety)
						</dd>
						<dt class="col-sm-2">
							@Html.DisplayNameFor(model => model.Koi.DateOfBirth)
						</dt>
						<dd class="col-sm-10">
							@Html.DisplayFor(model => model.Koi.DateOfBirth)
						</dd>
						<dt class="col-sm-2">
							@Html.DisplayNameFor(model => model.Koi.Size)
						</dt>
						<dd class="col-sm-10">
							@Html.DisplayFor(model => model.Koi.Size)
						</dd>
						<dt class="col-sm-2">
							@Html.Raw("Owner")
						</dt>
						<dd class="col-sm-10">
							@Html.DisplayFor(model => model.Koi.User.FullName)
						</dd>
					</dl>
					<form method="post" class="mt-3 animate__animated animate__slideInUp position-absolute bottom-0 end-50">
						<input type="hidden" asp-for="Koi.Id" />
						<input type="submit" value="Delete" class="btn btn-danger" /> |
						<a asp-page="./Index" class="btn btn-primary">Back to List</a>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>
